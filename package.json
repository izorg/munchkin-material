{
  "private": true,
  "name": "munchkin",
  "version": "16.2.4",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "check": "yarn check-knip && yarn check-prettier && yarn check-tsc && yarn check-eslint && yarn check-oxlint && yarn check-stylelint",
    "check-eslint": "eslint --cache",
    "check-knip": "knip --cache",
    "check-oxlint": "oxlint",
    "check-prettier": "prettier --cache --check --ignore-unknown .",
    "check-stylelint": "stylelint --cache \"**/*.css\"",
    "check-tsc": "tsc",
    "clean": "rimraf .parcel-cache/ node_modules/.cache/ .eslintcache .stylelintcache",
    "clean-all": "yarn workspaces foreach --all run clean",
    "format": "prettier --cache --ignore-unknown --write .",
    "get-version": "node scripts/version.js",
    "postinstall": "husky || true",
    "reinstall": "rm -r node_modules yarn.lock && yarn install",
    "skills-install": "skills experimental_install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/compat": "2.1.1",
    "@eslint/css": "2.0.1",
    "@eslint/js": "10.0.1",
    "@eslint/json": "2.1.1",
    "@html-eslint/eslint-plugin": "0.68.0",
    "@next/eslint-plugin-next": "16.4.6",
    "@semantic-release/commit-analyzer": "13.0.1",
    "@semantic-release/github": "12.0.10",
    "@semantic-release/release-notes-generator": "14.1.1",
    "@types/node": "26.6.6",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "eslint": "10.14.0",
    "eslint-config-flat-gitignore": "2.4.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-compat": "7.0.2",
    "eslint-plugin-formatjs": "8.1.4",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.17.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-only-error": "1.0.2",
    "eslint-plugin-perfectionist": "5.13.0",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-unicorn": "79.0.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "knip": "6.45.0",
    "lint-staged": "17.6.0",
    "oxlint": "1.93.0",
    "prettier": "3.9.10",
    "rimraf": "6.1.4",
    "semantic-release": "25.0.9",
    "skills": "1.8.0",
    "stylelint": "18.0.0",
    "stylelint-config-standard": "41.0.0",
    "stylelint-order": "8.1.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  },
  "alias": {
    "@formatjs/icu-messageformat-parser": "@formatjs/icu-messageformat-parser/no-parser.js",
    "process": false
  },
  "@parcel/resolver-default": {
    "packageExports": true
  }
}
